        </mxCell>
        <mxCell id="n26-127" value="ARDUINO_MOVE 中は毎ループ送信しない (mode = 5 は遷移時の 1 回のみ)&lt;br&gt;DONE を受け取るまで q キーは効かない / Ctrl+C は可" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" parent="1" vertex="1">
          <mxGeometry x="1600" y="2190" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n26-128" value="DONE 受信 → rasp_mode = DETECTION にして continue&lt;br&gt;(停止指令 mode = 0 も送らない)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" parent="1" vertex="1">
          <mxGeometry x="1600" y="2255" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n26-129" value="DETECTION に戻る → ボールが 250mm 圏内の&lt;br&gt;ままなら、次のループで再び mode = 5 を送信" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontColor=#FF0000;" parent="1" vertex="1">

          <mxGeometry x="540" y="2770" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n26-131" value="Arduino send Serial&lt;br&gt;angle_code = encode_angle(send_angle_deg)&lt;br&gt;dist_code = encode_distance_ver2(send_dist_mm)&lt;br&gt;msg = f&quot;{mode}{angle_code}{dist_code}\n&quot;&lt;br&gt;ser.write(msg.encode(&quot;ascii&quot;))" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" parent="1" vertex="1">
          <mxGeometry x="460" y="2870" width="280" height="95" as="geometry" />
        </mxCell>

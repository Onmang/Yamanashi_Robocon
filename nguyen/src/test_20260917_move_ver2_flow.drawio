          <mxGeometry x="730" y="2305" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n26-84" value="elif state == &quot;HOLD&quot; ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">

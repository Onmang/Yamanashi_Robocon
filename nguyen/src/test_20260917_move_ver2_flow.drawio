        <mxCell id="n26-1" value="Python 3.8 : test_20260917_move_ver2.py  (run flow)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="-1000" y="0" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n26-2" value="&lt;b&gt;Note (Python 3.8)&lt;/b&gt;&lt;br&gt;・match / case (Python 3.10〜) は使えないため、分岐はすべて &lt;b&gt;if / elif / else&lt;/b&gt; で記述&lt;br&gt;　→ 図中のひし形は if / elif の条件式をそのまま記載&lt;br&gt;&lt;br&gt;&lt;b&gt;rasp_mode&lt;/b&gt; : DETECTION / ARDUINO_MOVE&lt;br&gt;&lt;b&gt;target_obj&lt;/b&gt; : BALL  (FLAG / POLE は定義のみ)&lt;br&gt;&lt;b&gt;YOLO class&lt;/b&gt; : ball_ball:0, flag:1, pole:2, red_ball:3, yellow_ball:4&lt;br&gt;　ball_idx = 4, flag_idx = 1, pole_idx = 2&lt;br&gt;&lt;br&gt;&lt;b&gt;Definition&lt;/b&gt;&lt;br&gt;[dist_mm] : ボールとロボット座標の距離 (EMA 平滑化後)&lt;br&gt;[angle_deg] : ロボット正面からのボール角度 (EMA 平滑化後)&lt;br&gt;dist_th_1 = 250 mm : ボールをロボットの下に入れる閾値&lt;br&gt;angle_th_1 = 1 deg (現状未使用)&lt;br&gt;&lt;br&gt;&lt;b&gt;Serial&lt;/b&gt; : msg = f&quot;{mode}{angle_code}{dist_code}\n&quot;&lt;br&gt;ARDUINO = True (ver2) : シリアル通信 ON&lt;br&gt;&lt;b&gt;Arduino → Raspberry Pi&lt;/b&gt; : 動作完了時に &quot;DONE\n&quot; を返す前提&lt;br&gt;　→ &quot;DONE&quot; を受信したらテスト成功 (PASSED)" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;spacing=5;spacingTop=-20;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="-1000" y="60" width="520" height="360" as="geometry" />
        </mxCell>
        <mxCell id="n26-3" value="START" style="ellipse;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="565" y="40" width="70" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n26-4" value="import / macro 定義&lt;br&gt;DETECTION, ARDUINO_MOVE, BALL ...&lt;br&gt;dist_th_1 = 250, angle_th_1 = 1" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="500" y="110" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n26-5" value="if ARDUINO ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="540" y="215" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n26-6" value="Conect Arduino&lt;br&gt;serial.Serial(/dev/ttyUSB0, 115200)&lt;br&gt;sleep 2.0 s&lt;br&gt;reset input / output buffer" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="760" y="205" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n26-7" value="main()" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="540" y="320" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="n26-8" value="Load YOLO model&lt;br&gt;YOLO(YOLO_MODEL, task=&apos;detect&apos;)&lt;br&gt;conf = 0.5, iou = 0.45" style="rounded=0;whiteSpace=wrap;html=1;" parent="1" vertex="1">
          <mxGeometry x="500" y="395" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n26-9" value="try:" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="580" y="485" width="40" height="20" as="geometry" />
        </mxCell>
        <mxCell id="n26-10" value="Conect Camera D435i&lt;br&gt;init_realsense_camera()&lt;br&gt;640 x 480 @ 30fps&lt;br&gt;sleep 1.0 s" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" parent="1" vertex="1">
          <mxGeometry x="510" y="530" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n26-11" value="EMA_ALPHA = 0.30&lt;br&gt;MISS_LIMIT = 10&lt;br&gt;prev_angle = 0&lt;br&gt;prev_dist = 0&lt;br&gt;miss_count = 0&lt;br&gt;rasp_mode = DETECTION&lt;br&gt;target_obj = BALL&lt;br&gt;rx_buf = b&quot;&quot;" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="500" y="635" width="200" height="160" as="geometry" />
        </mxCell>
        <mxCell id="n26-12" value="While Loop" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="540" y="850" width="120" height="55" as="geometry" />

        </mxCell>
        <mxCell id="n26-81" value="rasp_mode = ARDUINO_MOVE&lt;br&gt;rx_buf = b&quot;&quot;&lt;br&gt;if ARDUINO: ser.reset_input_buffer()&lt;br&gt;print [Debug] Changed Arduino mode" style="whiteSpace=wrap;html=1;align=left;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1" parent="1" vertex="1">

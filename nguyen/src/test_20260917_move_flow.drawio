        <mxCell id="n26-76" value="# move  (Arduino への指令値を決定)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="720" y="2060" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="n26-77" value="if rasp_mode == DETECTION ?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="520" y="2085" width="160" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n26-78" value="if state == &quot;TRACK&quot; ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="530" y="2200" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n26-79" value="if dist_mm &lt; dist_th_1 ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="530" y="2305" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n26-80" value="mode = 5&lt;br&gt;send_dist_mm = 0&lt;br&gt;send_angle_deg = 0&lt;br&gt;test_count += 1" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="520" y="2410" width="160" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n26-81" value="if test_count &gt; ARDUINO_TEST_FRAMES ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="505" y="2515" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n26-82" value="rasp_mode = ARDUINO_MOVE" style="whiteSpace=wrap;html=1;align=left;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="520" y="2635" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="n26-83" value="mode = 1&lt;br&gt;send_dist_mm = dist_mm&lt;br&gt;send_angle_deg = angle_deg&lt;br&gt;rasp_mode = DETECTION" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="730" y="2305" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n26-84" value="elif state == &quot;HOLD&quot; ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="960" y="2200" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n26-85" value="mode = 1&lt;br&gt;send_dist_mm = prev_dist&lt;br&gt;send_angle_deg = prev_angle" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="950" y="2305" width="160" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n26-86" value="elif state == &quot;LOST&quot; ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1160" y="2200" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n26-87" value="mode = 0&lt;br&gt;send_dist_mm = 0&lt;br&gt;send_angle_deg = 0" style="whiteSpace=wrap;html=1;align=left;" parent="1" vertex="1">
          <mxGeometry x="1160" y="2305" width="140" height="65" as="geometry" />
        </mxCell>
        <mxCell id="n26-88" value="elif rasp_mode == ARDUINO_MOVE ?" style="rhombus;whiteSpace=wrap;html=1;align=center;fillColor=#b0e3e6;strokeColor=#0e8088;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1380" y="2085" width="180" height="75" as="geometry" />
        </mxCell>
        <mxCell id="n26-89" value="if test_count2 &gt; ARDUINO_TEST_FRAMES2 ?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="1375" y="2195" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="n26-90" value="print [Debug] Arduino mode test has been FINISHIED.&lt;br&gt;return (→ finally)" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fontColor=#FF3333;" parent="1" vertex="1">
